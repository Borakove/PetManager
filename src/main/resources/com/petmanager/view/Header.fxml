<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Pane?>

<HBox alignment="CENTER_LEFT" prefHeight="60.0" styleClass="header-bar" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.petmanager.controller.HeaderController">
    <children>
        <Label style="-fx-font-size: 20px; -fx-text-fill: white; -fx-font-weight: bold;" text="PetManager" />
        <Button onAction="#handleDashboardAction" styleClass="header-button" text="Dashboard">
            <HBox.margin>
                <Insets left="30.0" />
            </HBox.margin>
        </Button>
        <Button onAction="#handlePDVAction" styleClass="header-button" text="Ponto de Venda" />
        <Button onAction="#handleClientesAction" styleClass="header-button" text="Clientes e Pets" />
        <Button onAction="#handleProdutosAction" styleClass="header-button" text="Produtos" />
        <Button onAction="#handleRelatoriosAction" styleClass="header-button" text="Relatórios" />

        <Pane HBox.hgrow="ALWAYS" />

        <Label fx:id="nomeFuncionarioLabel" styleClass="header-user-label" text="Nome do Funcionário" />
        <Button onAction="#handleSairAction" styleClass="header-button" text="Sair" />
    </children>
</HBox>