<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.SplitPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="root" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.petmanager.controller.GestaoClientesController">
    <top>
        <fx:include source="Header.fxml" />
    </top>
    <center>
        <SplitPane dividerPositions="0.5" prefHeight="160.0" prefWidth="200.0">
            <items>
                <VBox spacing="10.0">
                    <children>
                        <Label styleClass="titulo-label" text="Clientes" />
                        <HBox spacing="10.0">
                            <children>
                                <TextField fx:id="buscaClienteField" promptText="Buscar cliente por nome..." HBox.hgrow="ALWAYS" />
                                <Button mnemonicParsing="false" onAction="#handleNovoClienteAction" text="Novo Cliente" />
                            </children>
                        </HBox>
                        <TableView fx:id="clientesTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colClienteNome" prefWidth="180.0" text="Nome" />
                                <TableColumn fx:id="colClienteTelefone" prefWidth="110.0" text="Telefone" />
                                <TableColumn fx:id="colClienteEmail" prefWidth="150.0" text="Email" />
                                <TableColumn fx:id="colClienteAcoes" prefWidth="150.0" text="Ações" />
                            </columns>
                        </TableView>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
                <VBox spacing="10.0">
                    <children>
                        <Label fx:id="detalhesClienteLabel" styleClass="titulo-label" text="Selecione um Cliente" />
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <children>
                                <Label text="Pets do Cliente:" />
                                <Button fx:id="adicionarPetButton" mnemonicParsing="false" onAction="#handleNovoPetAction" text="Adicionar Pet" />
                            </children>
                        </HBox>
                        <TableView fx:id="petsTable" VBox.vgrow="ALWAYS">
                            <columns>
                                <TableColumn fx:id="colPetNome" prefWidth="150.0" text="Nome" />
                                <TableColumn fx:id="colPetEspecie" prefWidth="100.0" text="Espécie" />
                                <TableColumn fx:id="colPetRaca" prefWidth="150.0" text="Raça" />
                            </columns>
                        </TableView>
                    </children>
                    <padding>
                        <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                    </padding>
                </VBox>
            </items>
        </SplitPane>
    </center>
</BorderPane>