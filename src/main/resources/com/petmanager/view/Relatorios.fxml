<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="root" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.petmanager.controller.RelatoriosController">
    <top>
        <fx:include source="Header.fxml" />
    </top>
    <center>
        <VBox spacing="10.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <HBox alignment="CENTER_LEFT" spacing="20.0">
                    <children>
                        <Label styleClass="titulo-label" text="Relatório de Vendas" />
                        <Button mnemonicParsing="false" onAction="#handleExportarAction" text="Exportar para Excel" />
                    </children>
                </HBox>
                <TableView fx:id="vendasTable" VBox.vgrow="ALWAYS">
                    <columns>
                        <TableColumn fx:id="colIdVenda" prefWidth="75.0" text="ID Venda" />
                        <TableColumn fx:id="colData" prefWidth="150.0" text="Data e Hora" />
                        <TableColumn fx:id="colCliente" prefWidth="250.0" text="Cliente" />
                        <TableColumn fx:id="colFuncionario" prefWidth="250.0" text="Funcionário" />
                        <TableColumn fx:id="colTotal" prefWidth="120.0" text="Valor Total (R$)" />
                    </columns>
                </TableView>
            </children>
        </VBox>
    </center>
</BorderPane>