<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="root" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.petmanager.controller.PontoDeVendaController">
    <top>
        <fx:include source="Header.fxml" />
    </top>
    <center>
        <HBox spacing="20.0">
            <padding>
                <Insets bottom="20.0" left="20.0" right="20.0" top="20.0" />
            </padding>
            <children>
                <VBox spacing="10.0" HBox.hgrow="SOMETIMES">
                    <children>
                        <Label styleClass="titulo-label" text="Itens" />
                        <TextField fx:id="buscaField" promptText="Buscar produto ou serviço..." />
                        <ListView fx:id="listaBusca" prefHeight="2000.0" />
                    </children>
                </VBox>
                <VBox spacing="10.0" HBox.hgrow="ALWAYS">
                    <children>
                        <Label styleClass="titulo-label" text="Carrinho" />
                        <TableView fx:id="carrinhoTable" prefHeight="2000.0">
                            <columns>
                                <TableColumn fx:id="colItem" prefWidth="250.0" text="Item" />
                                <TableColumn fx:id="colQtd" minWidth="80.0" prefWidth="80.0" text="Qtd" />
                                <TableColumn fx:id="colPrecoUnit" prefWidth="100.0" text="Preço Unit." />
                                <TableColumn fx:id="colPrecoTotal" prefWidth="100.0" text="Total" />
                                <TableColumn fx:id="colAcoes" minWidth="120.0" prefWidth="120.0" text="Ações" />
                            </columns>
                        </TableView>
                    </children>
                </VBox>
                <VBox maxWidth="300.0" minWidth="300.0" spacing="15.0" style="-fx-background-color: white; -fx-padding: 20; -fx-background-radius: 10;">
                    <children>
                        <Label styleClass="titulo-label" text="Resumo" />
                        <Label text="Cliente:" />
                        <ComboBox fx:id="clienteComboBox" prefWidth="300.0" promptText="Consumidor Final" />
                        <Label text="Método de Pagamento:" />
                        <ComboBox fx:id="pagamentoComboBox" prefWidth="300.0" promptText="Selecione..." />
                        <Label fx:id="totalLabel" style="-fx-font-size: 24px; -fx-font-weight: bold;" text="Total: R$ 0,00" />
                        <Button onAction="#handleFinalizarVendaAction" prefWidth="300.0" text="Finalizar Venda" />
                        <Label fx:id="mensagemLabel" />
                    </children>
                </VBox>
            </children>
        </HBox>
    </center>
</BorderPane>