<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Tab?>
<?import javafx.scene.control.TabPane?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="700.0" prefWidth="1200.0" styleClass="root" stylesheets="@../css/styles.css" xmlns="http://javafx.com/javafx/17" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.petmanager.controller.GestaoProdutosController">
    <top>
        <fx:include source="Header.fxml" />
    </top>
    <center>
        <TabPane tabClosingPolicy="UNAVAILABLE">
            <tabs>
                <Tab text="Produtos">
                    <content>
                        <VBox spacing="10.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="titulo-label" text="Gestão de Produtos" />
                                        <Button mnemonicParsing="false" onAction="#handleNovoProdutoAction" text="Novo Produto" />
                                    </children>
                                </HBox>
                                <TableView fx:id="produtosTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colProdutoNome" prefWidth="250.0" text="Nome do Produto" />
                                        <TableColumn fx:id="colProdutoPreco" prefWidth="100.0" text="Preço (R$)" />
                                        <TableColumn fx:id="colProdutoEstoque" prefWidth="100.0" text="Estoque" />
                                        <TableColumn fx:id="colProdutoAcoes" prefWidth="200.0" text="Ações" />
                                    </columns>
                                </TableView>
                            </children>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </VBox>
                    </content>
                </Tab>
                <Tab text="Serviços">
                    <content>
                        <VBox spacing="10.0">
                            <children>
                                <HBox alignment="CENTER_LEFT" spacing="10.0">
                                    <children>
                                        <Label styleClass="titulo-label" text="Gestão de Serviços" />
                                        <Button mnemonicParsing="false" onAction="#handleNovoServicoAction" text="Novo Serviço" />
                                    </children>
                                </HBox>
                                <TableView fx:id="servicosTable" VBox.vgrow="ALWAYS">
                                    <columns>
                                        <TableColumn fx:id="colServicoNome" prefWidth="250.0" text="Nome do Serviço" />
                                        <TableColumn fx:id="colServicoPreco" prefWidth="100.0" text="Preço (R$)" />
                                        <TableColumn fx:id="colServicoAcoes" prefWidth="200.0" text="Ações" />
                                    </columns>
                                </TableView>
                            </children>
                            <padding>
                                <Insets bottom="10.0" left="10.0" right="10.0" top="10.0" />
                            </padding>
                        </VBox>
                    </content>
                </Tab>
            </tabs>
        </TabPane>
    </center>
</BorderPane>